+async fn library_json(maxima_arc: LockedMaxima) -> Result<()> {
+    let mut maxima = maxima_arc.lock().await;
+    let mut entries = Vec::new();
+    for title in maxima.mut_library().games().await? {
+        let offer = title.base_offer();
+        let installed = offer.is_installed().await;
+        let execute_path = if installed { offer.execute_path(false).await.ok() } else { None };
+        entries.push(serde_json::json!({"slug": offer.slug(), "name": title.name(),
+            "offerId": offer.offer_id(), "installed": installed, "executePath": execute_path}));
+    }
+    println!("{}", serde_json::Value::Array(entries));
+    Ok(())
+}
+
+async fn install_game(maxima_arc: LockedMaxima, offer_id: &str, path: &str) -> Result<()> {
+    let path = PathBuf::from(path);
+    if !path.is_absolute() {
+        bail!("Install path {:?} is not absolute.", path);
+    }
+    let mut maxima = maxima_arc.lock().await;
+    let builds = maxima.content_manager().service().available_builds(offer_id).await?;
+    let Some(build) = builds.live_build() else {
+        bail!("Couldn't find a suitable game build");
+    };
+    println!("{}", serde_json::json!({"event": "build", "offerId": offer_id, "buildId": build.build_id()}));
+    let game = QueuedGameBuilder::default()
+        .offer_id(offer_id.to_owned())
+        .build_id(build.build_id().to_owned())
+        .path(path.clone())
+        .build()?;
+    maxima.content_manager().install_now(game).await?;
+    drop(maxima);
+
+    loop {
+        let mut maxima = maxima_arc.lock().await;
+        maxima.consume_pending_events();
+        maxima.update().await;
+        let Some(downloader) = maxima.content_manager().current() else {
+            break;
+        };
+        if let Some(error) = downloader.error() {
+            bail!("Install failed: {}", error);
+        }
+        println!("{}", serde_json::json!({"event": "progress", "downloaded": downloader.bytes_downloaded(),
+            "total": downloader.bytes_total(), "percent": downloader.percentage_done()}));
+        drop(maxima);
+        tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+    }
+    println!("{}", serde_json::json!({"event": "done", "path": path}));
+    Ok(())
+}
