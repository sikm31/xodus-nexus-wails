+/// Runs a game's touchup installer with its DirectX redistributable stubbed
+/// out. DXSETUP's Managed DirectX step needs .NET Framework and fails under
+/// Wine, aborting the touchup before it registers the game; Proton already
+/// ships the d3dx libraries. The original file is restored afterwards so the
+/// downloader's verification stays clean.
+pub async fn run_touchup_command(touchup: PathBuf, args: Vec<PathBuf>, install_path: &PathBuf) -> Result<(), NativeError> {
+    let dxsetup = crate::unix::fs::case_insensitive_path(install_path.join("__Installer/directx/redist/DXSETUP.exe"));
+    let stub = wine_prefix_dir()?.join("pfx/drive_c/windows/syswow64/rundll32.exe");
+    let original = dxsetup.with_file_name("DXSETUP.exe.nexus-original");
+    let stubbed = dxsetup.is_file() && stub.exists();
+    if stubbed {
+        std::fs::rename(&dxsetup, &original)?;
+        if let Err(err) = std::fs::copy(&stub, &dxsetup) {
+            std::fs::rename(&original, &dxsetup)?;
+            return Err(err.into());
+        }
+    }
+    let result = run_wine_command(touchup, Some(args), None, true, CommandType::Run).await;
+    if stubbed {
+        std::fs::rename(&original, &dxsetup)?;
+    }
+    result.map(|_| ())
+}
